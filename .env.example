# Server-only. Session pooler (5432) or reachable direct Supabase PostgreSQL.
# URL-encode password characters. Never use VITE_ for credentials.
DATABASE_URL=
# Optional IPv4 session-pooler URL for GitHub runners; never browser-side.
GITHUB_DATABASE_URL=
DATABASE_CA_FILE=
ENABLED_SOURCES=remotive,jobicy,remoteok,himalayas
MAX_JOB_AGE_DAYS=30
TARGET_JOB_COUNT=200
HOST=127.0.0.1
PORT=3001
LLM_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite
TAGGING_BATCH_SIZE=5
TAGGING_DELAY_MS=6500
TAGGING_MAX_COST_USD=2
LLM_TIMEOUT_MS=60000
# Optional MINIMAL/LOW/MEDIUM/HIGH; defaults depend on the Gemini model.
LLM_THINKING_LEVEL=
# Optional overrides; defaults apply ONLY to gemini-3.5-flash-lite.
# Costs are measured tokens times recorded standard paid-tier rates, not invoices.
LLM_INPUT_USD_PER_MILLION=
LLM_CACHED_INPUT_USD_PER_MILLION=
LLM_OUTPUT_USD_PER_MILLION=
LLM_PRICING_REFERENCE=
LLM_PRICING_BASIS=
