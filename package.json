{
  "name": "fresherjobs-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "ingest": "node server/src/cli.js",
    "test": "vitest run",
    "check": "node scripts/check.mjs",
    "dev": "concurrently --kill-others --names api,web \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "node server/src/index.js",
    "test:browser": "node scripts/browser-smoke.mjs",
    "db:migrate": "node scripts/migrate.mjs",
    "tag": "node server/src/tagging/cli.js",
    "evaluate": "node server/src/evaluation/cli.js",
    "report": "node scripts/report.mjs",
    "review:eligibility": "node scripts/recheck-eligibility.mjs",
    "github:setup": "node scripts/github-setup.mjs"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "lucide-react": "^1.77.0",
    "pg": "^8.16.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.17.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "jsdom": "^31.0.1",
    "libsodium-wrappers": "^0.8.4",
    "playwright-core": "^1.65.1",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
